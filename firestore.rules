rules_version = '2';

// ============================================
// TokoWarung — Firestore Security Rules
// ============================================
// PRINSIP KEAMANAN:
// 1. DILARANG: allow read, write: if true;
// 2. Role-based access control (RBAC).
// 3. Buyer hanya boleh akses data miliknya.
// 4. Seller hanya boleh akses data miliknya (sellerId == uid).
// 5. Courier hanya boleh akses order yang ditugaskan kepadanya.
// 6. Admin & Super Admin punya akses operasional sesuai role.
// 7. Field sensitif (identityNumber, bankAccount) tidak boleh di-read ke publik.
// 8. Validasi input wajib dilakukan di sini (defensive layer).
//
// Catatan: untuk integritas finansial, update status order, dan
// mutation yang kritis, SEBAIKNYA via Cloud Functions (server-side)
// dengan Admin SDK, BUKAN dari client langsung.
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- HELPERS -----
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function isBuyer() {
      return isSignedIn() && userRole() == 'BUYER';
    }

    function isSeller() {
      return isSignedIn() && userRole() == 'SELLER';
    }

    function isCourier() {
      return isSignedIn() && userRole() == 'COURIER';
    }

    function isAdmin() {
      return isSignedIn() && (userRole() == 'ADMIN' || userRole() == 'SUPER_ADMIN');
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'SUPER_ADMIN';
    }

    function isOwnData(userId) {
      return isSignedIn() && uid() == userId;
    }

    // Validasi tipe data string dan panjang
    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // Validasi harga (number positif)
    function isPositiveAmount(value) {
      return value is number && value >= 0 && value < 1000000000;
    }

    // ----- USERS -----
    match /users/{userId} {
      // Simplified: any signed-in user can read user profiles (for marketplace display)
      // Sensitive fields (identityNumber, bankAccount) are NOT in this collection
      allow read: if isSignedIn();

      // User hanya boleh update data miliknya sendiri, TIDAK boleh update role (kunci keamanan!)
      // Admin bisa update status user
      allow create: if isOwnData(userId)
                    && request.resource.data.role in ['BUYER', 'SELLER', 'COURIER']
                    && request.resource.data.uid == userId;

      allow update: if isOwnData(userId)
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys()) // TIDAK boleh ganti role sendiri
                    && !('status' in request.resource.data.diff(resource.data).affectedKeys()) // TIDAK boleh ganti status sendiri
                    || isAdmin();

      allow delete: if isSuperAdmin();
    }

    // ----- SELLERS -----
    match /sellers/{sellerId} {
      // Public store info (verified sellers only) bisa di-read siapa pun
      allow read: if true; // STRIP field sensitif di layer aplikasi (storeService)

      // Seller bisa create profile miliknya sendiri (saat register)
      allow create: if isOwnData(sellerId) && sellerId == uid();

      // Seller bisa update profile miliknya, TAPI tidak boleh ubah field sensitif
      // (verificationStatus, violationLevel, violationScore, identityNumber, bankAccount)
      allow update: if isOwnData(sellerId)
                    && !('verificationStatus' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('violationLevel' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('violationScore' in request.resource.data.diff(resource.data).affectedKeys())
                    || isAdmin();

      allow delete: if isSuperAdmin();
    }

    // ----- COURIERS -----
    match /couriers/{courierId} {
      allow read: if isSignedIn() && (isOwnData(courierId) || isAdmin());

      allow create: if isOwnData(courierId) && courierId == uid();

      // Courier bisa update beberapa field sendiri (isOnline, currentLocation, currentLoad)
      // Status verifikasi & violation hanya admin yang bisa ubah
      allow update: if isOwnData(courierId)
                    && !('status' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('violationLevel' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('totalDeliveries' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('rating' in request.resource.data.diff(resource.data).affectedKeys())
                    && request.resource.data.currentLocation.keys().hasAll(['lat', 'lng'])
                    || isAdmin();

      allow delete: if isSuperAdmin();
    }

    // ----- STORES (alias untuk verified seller public view) -----
    // Untuk MVP, stores collection = subset seller tanpa field sensitif.
    // Sama dengan sellers rules.
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ----- CATEGORIES -----
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----- PRODUCTS -----
    match /products/{productId} {
      // Public bisa read APPROVED & active products
      allow read: if resource.data.status == 'APPROVED' && resource.data.isActive == true
                    || isSeller() && resource.data.sellerId == uid()
                    || isAdmin();

      // Seller bisa create produk di bawah sellerId miliknya, status WAJIB DRAFT
      allow create: if isSeller()
                    && request.resource.data.sellerId == uid()
                    && request.resource.data.status == 'DRAFT'
                    && isNonEmptyString(request.resource.data.name, 120)
                    && isPositiveAmount(request.resource.data.price);

      // Seller bisa update produk miliknya, TIDAK boleh set status ke APPROVED sendiri
      // BUYER juga bisa update reservedStock (untuk reserve stok saat create order) — strict validation
      allow update: if (isSeller() && resource.data.sellerId == uid()
                    && request.resource.data.status != 'APPROVED')
                    || isAdmin()
                    // Buyer exception: hanya boleh update field reservedStock + updatedAt
                    // Tidak boleh ubah field lain (price, name, status, sellerId, dll)
                    || (isBuyer()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservedStock', 'updatedAt'])
                        && request.resource.data.reservedStock is number
                        && request.resource.data.reservedStock >= 0
                        && request.resource.data.reservedStock <= resource.data.stock
                        && request.resource.data.sellerId == resource.data.sellerId
                    );

      // Seller bisa hapus produk miliknya (soft delete recommended via status=SUSPENDED)
      allow delete: if (isSeller() && resource.data.sellerId == uid()) || isAdmin();
    }

    // ----- INVENTORY -----
    match /inventory/{inventoryId} {
      allow read: if isSignedIn() && (isSeller() || isAdmin());
      allow write: if isAdmin();
    }

    // ----- CARTS (per user) -----
    match /carts/{cartId} {
      allow read: if isOwnData(cartId);
      allow write: if isOwnData(cartId)
                    && request.resource.data.items is list
                    && request.resource.data.items.size() <= 50;
      allow delete: if isOwnData(cartId);
    }

    // ----- ORDERS -----
    match /orders/{orderId} {
      // Read: buyer miliknya, seller miliknya, courier yang ditugaskan, admin
      allow read: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        (resource.data.courierId == uid() && isCourier()) ||
        isAdmin()
      );

      // Create: buyer yang login, tidak boleh set status selain PENDING_PAYMENT
      allow create: if isBuyer()
                    && request.resource.data.buyerId == uid()
                    && request.resource.data.orderStatus == 'PENDING_PAYMENT'
                    && isPositiveAmount(request.resource.data.total)
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50;

      // Update: permission berbasis role
      // - Buyer bisa update status order-nya sendiri (cancel, confirm delivery)
      // - Seller bisa update status order-nya sendiri (confirm, prepare, ready_for_pickup, assign courier)
      // - Courier bisa update status order yang ditugaskan ke dia (accept, going_to_pickup, picked_up, delivering, arrived)
      // - Admin bisa update apa saja
      // Validation: tidak boleh ubah buyerId, sellerId, items, subtotal, total (anti fraud)
      allow update: if isSignedIn() && (
        // Admin bisa semua
        isAdmin()
        // Buyer: hanya boleh update order miliknya, tidak boleh ubah financial fields
        || (isBuyer() && resource.data.buyerId == uid()
            && !('buyerId' in request.resource.data.diff(resource.data).affectedKeys())
            && !('sellerId' in request.resource.data.diff(resource.data).affectedKeys())
            && !('items' in request.resource.data.diff(resource.data).affectedKeys())
            && !('subtotal' in request.resource.data.diff(resource.data).affectedKeys())
            && !('total' in request.resource.data.diff(resource.data).affectedKeys())
            && !('paymentMethod' in request.resource.data.diff(resource.data).affectedKeys())
        )
        // Seller: hanya boleh update order miliknya, tidak boleh ubah financial fields
        || (isSeller() && resource.data.sellerId == uid()
            && !('buyerId' in request.resource.data.diff(resource.data).affectedKeys())
            && !('sellerId' in request.resource.data.diff(resource.data).affectedKeys())
            && !('items' in request.resource.data.diff(resource.data).affectedKeys())
            && !('subtotal' in request.resource.data.diff(resource.data).affectedKeys())
            && !('total' in request.resource.data.diff(resource.data).affectedKeys())
            && !('paymentMethod' in request.resource.data.diff(resource.data).affectedKeys())
        )
        // Courier: hanya boleh update order yang ditugaskan ke dia, tidak boleh ubah financial fields
        // Courier juga TIDAK boleh set courierId sendiri (admin/seller yang assign)
        || (isCourier() && resource.data.courierId == uid()
            && !('buyerId' in request.resource.data.diff(resource.data).affectedKeys())
            && !('sellerId' in request.resource.data.diff(resource.data).affectedKeys())
            && !('courierId' in request.resource.data.diff(resource.data).affectedKeys())
            && !('items' in request.resource.data.diff(resource.data).affectedKeys())
            && !('subtotal' in request.resource.data.diff(resource.data).affectedKeys())
            && !('total' in request.resource.data.diff(resource.data).affectedKeys())
            && !('paymentMethod' in request.resource.data.diff(resource.data).affectedKeys())
        )
      );

      // Delete: tidak boleh (soft delete via CANCELLED)
      allow delete: if false;
    }

    // ----- ORDER ITEMS (sub-collection) -----
    match /orders/{orderId}/orderItems/{itemId} {
      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == uid() ||
        get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == uid() ||
        isAdmin()
      );
      allow write: if false; // create via transaction saat create order
    }

    // ----- PAYMENTS -----
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        isAdmin()
      );
      // Buyer bisa create manual payment proof (status PENDING_VERIFICATION)
      allow create: if isBuyer()
                    && request.resource.data.buyerId == uid()
                    && request.resource.data.status == 'PENDING_VERIFICATION';
      // Admin bisa update (verify/reject payment proof)
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ----- TRANSACTIONS (ledger) -----
    match /transactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.actorId == uid() ||
        resource.data.userId == uid() ||
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        isAdmin()
      );
      // Phase 3 tanpa Cloud Function: user signed-in bisa create transactions (utk audit)
      // Kalau sudah Blaze, pindahkan ke Cloud Function only (allow write: if false)
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // ----- WALLETS (seller & courier) -----
    // Phase 3 tanpa Cloud Function: wallet updates client-side.
    // Mitigation via strict field validation.
    match /sellerWallets/{walletId} {
      allow read: if isOwnData(walletId) || isAdmin();
      // Create (auto-create wallet with zero balances)
      allow create: if isSignedIn() && walletId == uid()
                    && request.resource.data.pendingBalance == 0
                    && request.resource.data.availableBalance == 0
                    && request.resource.data.withdrawnTotal == 0;
      // Update — owner & admin, with strict field validation
      // Owner: hanya boleh update via specific functions (withdrawal, dll)
      // Tidak boleh langsung set availableBalance/withdrawnTotal/etc (anti-fraud)
      allow update: if isAdmin()
                    || (isOwnData(walletId) && isSeller()
                        && !('availableBalance' in request.resource.data.diff(resource.data).affectedKeys())
                        && !('commissionTotal' in request.resource.data.diff(resource.data).affectedKeys())
                        && !('refundTotal' in request.resource.data.diff(resource.data).affectedKeys())
                        && !('adjustmentTotal' in request.resource.data.diff(resource.data).affectedKeys())
                    );
      allow delete: if isSuperAdmin();
    }

    match /courierWallets/{walletId} {
      allow read: if isOwnData(walletId) || isAdmin();
      allow create: if isSignedIn() && walletId == uid()
                    && request.resource.data.earnings == 0
                    && request.resource.data.codCollected == 0
                    && request.resource.data.codSettled == 0;
      allow update: if isAdmin()
                    || (isOwnData(walletId) && isCourier()
                        && !('codSettled' in request.resource.data.diff(resource.data).affectedKeys())
                        && !('adjustmentTotal' in request.resource.data.diff(resource.data).affectedKeys())
                    );
      allow delete: if isSuperAdmin();
    }

    // ----- WITHDRAWALS -----
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid()
                    && isPositiveAmount(request.resource.data.amount)
                    && request.resource.data.status == 'REQUESTED';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ----- DELIVERIES -----
    match /deliveries/{deliveryId} {
      allow read: if isSignedIn() && (
        resource.data.courierId == uid() ||
        resource.data.sellerId == uid() ||
        resource.data.buyerId == uid() ||
        isAdmin()
      );

      // Create: via Cloud Function saat order COURIER_ASSIGNED
      allow create: if false;

      // Update: courier bisa update status delivery miliknya, admin bisa
      allow update: if (isCourier() && resource.data.courierId == uid())
                    || isAdmin();
    }

    // ----- DELIVERY EVENTS (tracking history) -----
    match /deliveryEvents/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.courierId == uid() ||
        isAdmin() ||
        get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.buyerId == uid()
      );
      allow create: if isCourier() && request.resource.data.courierId == uid();
      allow update: if false;
      allow delete: if false;
    }

    // ----- REVIEWS -----
    match /reviews/{reviewId} {
      allow read: if true; // Public bisa lihat reviews
      allow create: if isBuyer() && request.resource.data.buyerId == uid()
                    && request.resource.data.targetType in ['PRODUCT', 'SELLER', 'COURIER']
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && isNonEmptyString(request.resource.data.comment, 500);
      // Buyer bisa update comment sendiri, TIDAK boleh ubah rating (anti-manipulasi)
      allow update: if isOwnData(resource.data.buyerId) && (
        !('rating' in request.resource.data.diff(resource.data).affectedKeys())
        && !('targetType' in request.resource.data.diff(resource.data).affectedKeys())
        && !('targetId' in request.resource.data.diff(resource.data).affectedKeys())
      );
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ----- REPORTS -----
    match /reports/{reportId} {
      allow read: if isAdmin() || isOwnData(resource.data.reporterId);
      allow create: if isSignedIn() && request.resource.data.reporterId == uid()
                    && request.resource.data.type in ['PRODUCT', 'SELLER', 'COURIER', 'ORDER', 'REVIEW', 'CHAT']
                    && request.resource.data.priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT']
                    && isNonEmptyString(request.resource.data.reason, 100);
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ----- DISPUTES -----
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        uid() in resource.data.participants || isAdmin()
      );
      allow create: if isSignedIn()
                    && (uid() in request.resource.data.participants)
                    && request.resource.data.type in ['BUYER_VS_SELLER', 'BUYER_VS_COURIER', 'SELLER_VS_COURIER']
                    && isNonEmptyString(request.resource.data.reason, 200);
      // Participants bisa add message ke dispute mereka
      // Admin bisa resolve/close
      allow update: if isAdmin()
                    || (isSignedIn() && uid() in resource.data.participants
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'updatedAt'])
                    );
      allow delete: if false;
    }

    // ----- INCIDENTS -----
    match /incidents/{incidentId} {
      allow read: if isAdmin() || isOwnData(resource.data.reporterId);
      allow create: if isSignedIn()
                    && request.resource.data.type in ['COURIER_NO_DELIVERY', 'COURIER_MISSING', 'COD_NOT_SETTLED', 'PRODUCT_DAMAGED', 'PRODUCT_PROHIBITED', 'SELLER_FRAUD', 'BUYER_FRAUD', 'COURIER_FRAUD', 'PAYMENT_ISSUE', 'OTHER']
                    && isNonEmptyString(request.resource.data.description, 1000);
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ----- VIOLATIONS -----
    match /violations/{violationId} {
      allow read: if isAdmin() || isOwnData(resource.data.sellerId);
      allow create: if isAdmin()
                    && request.resource.data.action in ['WARNING', 'RESTRICTED', 'SUSPENDED', 'BANNED']
                    && isNonEmptyString(request.resource.data.description, 1000);
      allow update: if isAdmin();
      allow delete: if false; // RIWAYAT PELANGGARAN TIDAK BOLEH DIHAPUS
    }

    // ----- NOTIFICATIONS -----
    match /notifications/{notifId} {
      allow read: if isOwnData(resource.data.userId);
      allow create: if false; // via Cloud Function
      allow update: if isOwnData(resource.data.userId); // mark as read
      allow delete: if isOwnData(resource.data.userId);
    }

    // ----- MESSAGES (chat) — Phase 5 -----
    // Top-level messages collection stores CONVERSATIONS (not individual messages).
    // Individual messages stored as sub-collection: messages/{conversationId}/messages/{messageId}
    match /messages/{conversationId} {
      allow read: if isSignedIn() && (
        uid() in resource.data.participants || isAdmin()
      );
      allow create: if isSignedIn() && (uid() in request.resource.data.participants);
      // Participants bisa update lastMessage, lastMessageAt, unreadCount
      allow update: if isAdmin()
                    || (isSignedIn() && uid() in resource.data.participants
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'unreadCount', 'updatedAt'])
                    );
      allow delete: if false;
    }

    // Individual chat messages (sub-collection)
    match /messages/{conversationId}/messages/{messageId} {
      allow read: if isSignedIn() && (
        // Must be participant in the parent conversation
        uid() in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants
      );
      allow create: if isSignedIn()
                    && request.resource.data.senderId == uid()
                    && uid() in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants
                    && isNonEmptyString(request.resource.data.text, 1000);
      allow update: if isOwnData(resource.data.senderId);
      allow delete: if isAdmin() || isOwnData(resource.data.senderId);
    }

    // ----- PROMOTIONS & COUPONS (Phase 5) -----
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: read public, create by admin & seller (for own), update by owner or admin
    match /coupons/{couponId} {
      allow read: if true; // Public bisa lihat voucher aktif (untuk display di checkout)
      // Admin bisa create any voucher (PLATFORM type)
      // Seller bisa create voucher untuk own store (SELLER type + sellerIdScope == uid())
      allow create: if isAdmin()
                    || (isSeller() && request.resource.data.ownerType == 'SELLER'
                        && request.resource.data.ownerId == uid()
                        && (request.resource.data.sellerIdScope == null || request.resource.data.sellerIdScope == uid())
                    );
      // Owner bisa update (deactivate), admin bisa update
      allow update: if isAdmin()
                    || (isSeller() && resource.data.ownerId == uid() && resource.data.ownerType == 'SELLER');
      allow delete: if isAdmin();
    }

    // ----- ADS (Phase 5) -----
    match /ads/{adId} {
      allow read: if true;
      // Seller create campaign
      allow create: if isSeller() && request.resource.data.sellerId == uid()
                    && request.resource.data.status == 'PENDING_APPROVAL';
      // Seller bisa update own campaign (pause/resume, track impression/click/conversion)
      // Admin bisa update (approve/reject)
      allow update: if (isSeller() && resource.data.sellerId == uid())
                    || isAdmin();
      allow delete: if isAdmin() || (isSeller() && resource.data.sellerId == uid());
    }

    // ----- AUDIT LOGS -----
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // create via Cloud Function only
      allow delete: if false; // JANGAN PERNAH
    }

    // ----- SETTINGS -----
    match /settings/{settingId} {
      allow read: if true; // settings bersifat public (commission, etc)
      allow write: if isSuperAdmin();
    }

    // ----- ZONES -----
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----- REPORT ABUSE -----
    match /reportAbuse/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}
