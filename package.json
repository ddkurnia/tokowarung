{
  "name": "tokowarung",
  "version": "0.1.0",
  "private": true,
  "description": "TokoWarung - Local Marketplace 2026 (Vanilla JS + Firebase). Buyer, Seller, Courier, Admin ecosystem.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:rules": "npx -y firebase-tools deploy --only firestore:rules,firestore:indexes",
    "deploy:storage": "npx -y firebase-tools deploy --only storage",
    "deploy:functions": "npx -y firebase-tools deploy --only functions",
    "deploy:firebase": "npx -y firebase-tools deploy --only firestore:rules,firestore:indexes,storage,functions",
    "seed": "node scripts/seed.mjs",
    "deploy:vercel": "vercel --prod"
  },
  "dependencies": {
    "firebase": "^10.12.2"
  },
  "devDependencies": {
    "vite": "^5.3.1"
  }
}
