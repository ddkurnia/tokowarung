# ============================================
# TokOnline — .gitignore
# ============================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-ssr/
*.local

# Environment variables (WAJIB — jangan commit secret!)
.env
.env.local
.env.*.local
.env.production
.env.development

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
functions/node_modules/
functions/lib/
functions/.env

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.eslintcache
.vite/

# Misc
coverage/
*.pid
*.seed
*.pid.lock

# Skills folder (internal, not part of TokOnline app)
skills/
upload/
serviceAccount.json
serviceAccountKey.json

# Download folder (artifacts, not source)
download/
