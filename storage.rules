// ============================================
// TokoWarung — Firebase Storage Rules
// ============================================
// CATATAN PENTING:
// Image storage utama pakai CLOUDINARY (bukan Firebase Storage).
// Firebase Storage rules tetap dipertahankan untuk:
//   - Private documents (seller docs, courier docs) — bila dibutuhkan di masa depan
//   - Order proof photos (COD, delivery confirmation) — bila ingin simpan private
//
// Saat ini, semua product images & avatars akan di-upload ke Cloudinary via
// UNSIGNED UPLOAD PRESET (config di .env). Tidak butuh Firebase Storage.
// ============================================

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() {
      return firestore(/databases/(default)/documents/users/$(uid())).data;
    }
    function isAdmin() {
      return isSignedIn() && (userDoc().role == 'ADMIN' || userDoc().role == 'SUPER_ADMIN');
    }
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Default: deny all. Firebase Storage tidak dipakai untuk image storage publik
    // (image via Cloudinary). Hanya enable jika nanti dibutuhkan untuk private docs.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
