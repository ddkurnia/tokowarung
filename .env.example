# ============================================
# TokOnline.com — Environment Variables (TEMPLATE)
# ============================================
# Salin file ini menjadi `.env` (untuk local dev) dan `.env.production` (untuk build).
# JANGAN PERNAH commit file `.env` yang berisi nilai asli ke repository publik.
#
# Semua nilai Firebase di bawah DIDAPAT dari Firebase Console:
#   Project Settings → General → Your apps → SDK setup and configuration
#
# Untuk deploy ke Vercel, set variabel yang sama (tanpa prefix) di:
#   Vercel Project → Settings → Environment Variables
# ============================================

# --- Firebase Client SDK (public, aman di-expose ke browser) ---
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --- App-level config ---
VITE_APP_NAME=TokOnline
VITE_APP_URL=https://tokonline.com
VITE_DEFAULT_ROLE=BUYER

# --- Optional: Maps (untuk fitur location-aware marketplace) ---
# VITE_MAP_TILES_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_DEFAULT_LAT=-6.2
# VITE_MAP_DEFAULT_LNG=106.8
# VITE_MAP_DEFAULT_ZOOM=13

# --- Optional: Payment gateway (jangan hardcode secret di client!) ---
# Payment secret hanya boleh ada di Cloud Functions / server-side.
# VITE_PAYMENT_PUBLIC_KEY=public-key-only

# ============================================
# Firebase Admin / Cloud Functions (SERVER-SIDE ONLY)
# ============================================
# File-file di bawah ini hanya untuk Firebase Cloud Functions,
# TIDAK BOLEH di-expose ke browser. Simpan di /functions/.env
#
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# PAYMENT_SERVER_KEY=server-side-secret
# ============================================
