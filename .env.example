# ============================================
# TokoWarung — Environment Variables (TEMPLATE)
# ============================================
# Salin file ini menjadi `.env` (untuk local dev) dan set variabel yang sama di:
# - Vercel Project → Settings → Environment Variables (untuk production)
# - GitHub Secrets (untuk CI/CD, jika perlu)
#
# JANGAN PERNAH commit file `.env` yang berisi nilai asli ke repository publik.
# ============================================

# --- Firebase Client SDK (public, aman di-expose ke browser) ---
# Dapatkan dari: Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --- Cloudinary (PUBLIC — aman di-expose ke browser) ---
# HANYA cloud name + upload preset di client.
# API Secret HANYA untuk Cloud Functions (server-side), JANGAN masukkan ke sini.
# Setup: https://cloudinary.com/console → Settings → Upload → Upload presets
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# --- App-level config ---
VITE_APP_NAME=TokoWarung
VITE_APP_URL=https://tokowarung.vercel.app
VITE_DEFAULT_ROLE=BUYER

# --- Maps (optional, untuk location-aware marketplace) ---
VITE_MAP_DEFAULT_LAT=-6.2
VITE_MAP_DEFAULT_LNG=106.8
VITE_MAP_DEFAULT_ZOOM=13

# ============================================
# SERVER-SIDE ONLY (Cloud Functions / Cloudinary Admin)
# ============================================
# File-file di bawah ini hanya untuk Firebase Cloud Functions,
# TIDAK BOLEH di-expose ke browser. Simpan di /functions/.env
#
# Cloudinary API Secret (untuk signed uploads, admin operations, image delete):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_API_KEY=742421365262691
# CLOUDINARY_API_SECRET=your-api-secret-here
# CLOUDINARY_CLOUD_NAME=dnpdjhdgr
#
# Firebase Admin SDK (service account JSON):
# FIREBASE_PROJECT_ID=tokowarung-15b64
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tokowarung-15b64.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ============================================
